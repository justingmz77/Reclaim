{
  "name": "reclaim",
  "version": "1.0.0",
  "description": "A web application to help university students improve mental health and wellness",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "seed": "node bin/seed.js",
    "seed:fresh": "node bin/seed.js --fresh",
    "db:clean": "node bin/db-clean.js all",
    "db:clean:dev": "node bin/db-clean.js dev",
    "db:clean:test": "node bin/db-clean.js test",
    "postinstall": "npm run seed",
    "prepare": "playwright install",
    "test": "node bin/test.js all",
    "test:jest": "node bin/test.js jest",
    "test:e2e": "node bin/test.js e2e",
    "test:e2e:headed": "node bin/test.js e2e:headed",
    "test:coverage": "jest -c tests/jest.config.js --coverage"
  },
  "nodemonConfig": {
    "ignore": [
      "node_modules",
      "reclaim.db"
    ]
  },
  "keywords": [
    "mental-health",
    "wellness",
    "students"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "bcrypt": "^5.1.1",
    "better-sqlite3": "^12.5.0",
    "express": "^4.18.2",
    "express-session": "^1.17.3",
    "path": "^0.12.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.1",
    "cross-env": "^10.1.0",
    "jest": "^30.2.0",
    "nodemon": "^3.1.11",
    "supertest": "^7.2.2"
  }
}
